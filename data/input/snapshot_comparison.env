# Snapshot-comparison runtime configuration.
# Load with:
#   source data/input/snapshot_comparison.env
#   make run-snapshot-comparison

export SARGAZO_GRID_NX=50
export SARGAZO_GRID_NY=50
export SARGAZO_VELOCITY_MODE_X=1
export SARGAZO_VELOCITY_MODE_Y=1
export SARGAZO_LENGTH_X=5.0
export SARGAZO_LENGTH_Y=5.0
export SARGAZO_GAMMA=2.0

export SARGAZO_BETA=0.01
export SARGAZO_THETA=1.0
export SARGAZO_SIGMA=0.01
export SARGAZO_TIME_STEP=1.0e-5
export SARGAZO_N_OBSERVATIONS=200001
export SARGAZO_SEED=42

export SARGAZO_SNAPSHOT_TIMES="0,0.5,2.0"
# `make run-snapshot-comparison` and `make plot-snapshot-comparison` use
# SARGAZO_SNAPSHOT_TIMES.
# `make video-snapshot-comparison` uses the frame-count variables below.
# export SARGAZO_SNAPSHOT_FRAME_COUNT=1210
# export SARGAZO_SNAPSHOT_INITIAL_TIME=0.0
# export SARGAZO_SNAPSHOT_FINAL_TIME=2.0
# export SARGAZO_SNAPSHOT_COMPARISON_FILE="data/output/custom_solution_snapshot_comparison.csv"

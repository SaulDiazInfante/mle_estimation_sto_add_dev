# Snapshot-comparison runtime configuration.
# Load with:
#   source data/input/snapshot_comparison.env
#   make run-snapshot-comparison

export SPDE_GRID_NX=200
export SPDE_GRID_NY=200
# Optional physical plotting grid for reconstructed snapshots. If unset,
# the snapshot driver uses SPDE_GRID_NX/Y.
# export SPDE_SNAPSHOT_GRID_NX=100
# export SPDE_SNAPSHOT_GRID_NY=100
export SPDE_VELOCITY_MODE_X=1
export SPDE_VELOCITY_MODE_Y=1
export SPDE_LENGTH_X=5.0
export SPDE_LENGTH_Y=5.0
export SPDE_GAMMA=2.0

export SPDE_BETA=0.01
export SPDE_THETA=1.0
export SPDE_SIGMA=0.01
export SPDE_TIME_STEP=1.0e-5
export SPDE_N_OBSERVATIONS=200001
export SPDE_SEED=42

export SPDE_SNAPSHOT_TIMES="0,0.5,2.0"
# `make run-snapshot-comparison` and `make plot-snapshot-comparison` use
# SPDE_SNAPSHOT_TIMES.
# `make video-snapshot-comparison` uses the frame-count variables below.
# export SPDE_SNAPSHOT_FRAME_COUNT=1210
# export SPDE_SNAPSHOT_INITIAL_TIME=0.0
# export SPDE_SNAPSHOT_FINAL_TIME=2.0
# export SPDE_SNAPSHOT_COMPARISON_FILE="data/output/custom_solution_snapshot_comparison.csv"

# Snapshot-comparison runtime configuration.
# When present, `make run-snapshot-comparison` automatically sources this file.
# The default snapshot comparison workflow is capped at 10,000 integration steps.

export SPDE_GRID_NX=50
export SPDE_GRID_NY=50

export SPDE_LENGTH_X=5.0
export SPDE_LENGTH_Y=5.0

export SPDE_GAMMA=.9
export SPDE_BETA=0.01
export SPDE_THETA=.9
export SPDE_SIGMA=0.7

# --- Production configuration: one frame per integration step ---------------
# Time horizon = (N_OBSERVATIONS - 1) * TIME_STEP = 9999 * 5e-5 = 0.49995
export SPDE_TIME_STEP=5.0e-5
export SPDE_N_OBSERVATIONS=10000
# ----------------------------------------------------------------------------
export SPDE_SEED=42

# Manual times (used when SPDE_SNAPSHOT_USE_FRAME_COUNT is not set).
export SPDE_SNAPSHOT_TIMES="0,0.25,0.49995"

# Per-step frame-count mode: one frame per integration step.
export SPDE_SNAPSHOT_USE_FRAME_COUNT=1
export SPDE_SNAPSHOT_FRAME_COUNT=10000
export SPDE_SNAPSHOT_INITIAL_TIME=0.0
export SPDE_SNAPSHOT_FINAL_TIME=0.49995

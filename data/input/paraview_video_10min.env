# Snapshot-comparison runtime configuration for a ParaView video capped at 10 min.
#
# The ParaView exporter uses 8 fps by default:
#   10 min * 60 s/min * 8 frames/s = 4800 frames

export SPDE_GRID_NX=50
export SPDE_GRID_NY=50

export SPDE_LENGTH_X=5.0
export SPDE_LENGTH_Y=5.0

export SPDE_GAMMA=.5
export SPDE_BETA=0.01
export SPDE_THETA=.9
export SPDE_SIGMA=1.0

# Time horizon = (N_OBSERVATIONS - 1) * TIME_STEP = 9999 * 5e-5 = 0.49995.
export SPDE_TIME_STEP=5.0e-5
export SPDE_N_OBSERVATIONS=10000
export SPDE_SEED=42

# Static snapshots, used only when SPDE_SNAPSHOT_USE_FRAME_COUNT is not set.
export SPDE_SNAPSHOT_TIMES="0,0.25,0.49995"

# Animation snapshots: 4800 frames at 8 fps gives exactly 600 seconds.
export SPDE_SNAPSHOT_USE_FRAME_COUNT=1
export SPDE_SNAPSHOT_FRAME_COUNT=4800
export SPDE_SNAPSHOT_INITIAL_TIME=0.0
export SPDE_SNAPSHOT_FINAL_TIME=0.49995
